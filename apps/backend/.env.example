DATABASE_URL=postgresql+psycopg://frugal:frugal_dev@localhost:5432/frugal_living

# AI calls currently route through the Claude Code CLI (`claude -p`) — no key
# needed. Set this only if you switch llm.py:get_client() back to the SDK.
ANTHROPIC_API_KEY=
JWT_SECRET=change-me-in-prod
ENV=local
LOG_LEVEL=INFO

# Content ingestion (Tier A cross-cutting)
YOUTUBE_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=frugal-living-dev/0.1 by yourname

# Voice (optional, for "hey Hearth")
OPENAI_API_KEY=

# Optional: bootstrap a default admin on app startup.
# If set, the user is created (if missing) or promoted to admin (if present).
# The password is only used at first creation; rotate via POST /auth/password.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_DISPLAY_NAME=
